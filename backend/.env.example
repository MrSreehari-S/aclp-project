# ================================
# CodeClash - Backend Configuration
# ================================

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/codeclash?retryWrites=true&w=majority
# Local Example: mongodb://localhost:27017/codeclash
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aclp?retryWrites=true&w=majority

# JSON Web Token Secret (used for signing auth tokens)
# Generate a strong random key (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_here

# Judge0 Code Execution API (RapidAPI)
# Get a free key at: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_judge0_key_here

